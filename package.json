{
  "name": "syndrome",
  "private": true,
  "version": "0.0.0",
  "description": "Syndrome by SEEQuant — interactive quantum error correction visualizer and game",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx tools/deploy/stage.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vitest bench --run --reporter=verbose tools/bench",
    "validate": "tsx tools/validate/cli.ts",
    "video": "tsx tools/video/cli.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "check:prod": "tsx tools/deploy/check-prod.ts",
    "deploy": "npm run build && tsx tools/deploy/check-prod.ts --production && wrangler deploy"
  },
  "dependencies": {
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  },
  "license": "AGPL-3.0-only"
}
